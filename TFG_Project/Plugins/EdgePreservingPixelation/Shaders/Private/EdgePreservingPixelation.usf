// EdgePreservingPixelation.usf
// TFG: Pipeline de pixelacion en tiempo real con preservacion de bordes.
// Fase 3: Deteccion de bordes geometricos via puntuacion combinada de dos senales,
//         cada una evaluada con el test min(Dev2, Jump) por eje:
//
//   Test min(Dev2, Jump) para un par de vecinos opuestos (A, Centro, B):
//     Dev2 = |2*C - A - B|  (segundo orden: cero en rampas lineales)
//     Jump = |A - B|        (primer orden: cero en curvatura simetrica)
//     Score = min(Dev2, Jump): alto solo para escalones geometricos reales.
//
//   Senal 1: Profundidad lineal (SceneDepth), 4 ejes H/V/D1/D2.
//   Senal 2: Normal del GBuffer (GBufferA.rgb), misma logica vectorial.
//   Fusion:  CombinedScore = DepthWeight * Score1 + NormalWeight * Score2.
//
// Fase 3b: Mezcla adaptativa consciente de profundidad.
//   La rejilla de bloques es UNIFORME (mismo PixelSize en todas partes).
//   En bloques de borde, el punto de muestreo dentro del bloque cambia al texel
//   de menor profundidad lineal (superficie en primer plano).
//   Transicion continua: Color = lerp(Centroide, MasCercano, BlendFactor)
//   donde BlendFactor = saturate(CombinedScore / EdgeThreshold).
//
//         Modo debug (EPP.DebugMode 1): bordes en blanco sobre negro, sin mezcla.
//
// Fase 4 — Compensacion de jitter TAA en el detector Sobel (EPP.JitterCompensation):
//   El jitter sub-pixel que aplica TAA desplaza cada frame la geometria renderizada
//   entre fracciones de pixel. Sin compensacion, el Sobel lee posiciones ligeramente
//   distintas cada frame, causando que bordes cercanos al umbral cambien su decision
//   borde/no-borde de forma binaria → parpadeo visual.
//
//   Solucion: calcular JitterUVDelta (offset en UV derivado de View.TemporalAAJitter.xy),
//   convertirlo a espacio de pixel (JitterPx) y desplazar cada muestreo con round():
//     texel = round(ScreenCoord + JitterPx)
//   round() elige el texel entero mas cercano a la posicion neutral-geometrica del centroide
//   en este frame. No se usa SampleLevel (bilineal) porque la profundidad es una funcion
//   escalon en bordes: interpolar entre primer plano y fondo crea valores artificiales que
//   varian sub-pixel con el jitter, amplificando el parpadeo en lugar de eliminarlo.
//   Con round() el texel elegido solo cambia cuando el jitter supera medio pixel, lo que
//   ocurre raramente; el Sobel ve la misma lectura en frames consecutivos → sin parpadeo.
//
//   Derivacion de JitterUVDelta (vease comentario en MainCS).
//
// Compatible con UE5 5.5, Shader Model 5+ (D3D12 / Vulkan).
// Punto de entrada del Compute Shader: MainCS.

// Platform.ush:         macros y tipos de compatibilidad entre backends (D3D12, Vulkan, Metal).
// Common.ush:           declara cbuffer View{} (InvDeviceZToWorldZTransform, TemporalAAJitter, etc.)
//                       y ConvertFromDeviceZ().
// SceneTexturesCommon.ush: declara el uniform buffer SceneTexturesStruct (FSceneTextureUniformParameters)
//                       y los helpers CalcSceneDepth(uint2), CalcSceneDepth(float2), etc.
//                       Incluye Common.ush internamente; todos usan #pragma once, sin duplicaciones.
#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"
#include "/Engine/Private/SceneTexturesCommon.ush"

// =============================================================================
// Recursos de entrada — Shader Resource Views (SRV)
// =============================================================================

// Color de escena LDR post-tonemap. Formato tipico: B8G8R8A8 o R10G10B10A2.
Texture2D          SceneColor;

// Buffer de velocidad por pixel en NDC/frame. Reservado para Fase 4 (estabilizacion temporal).
Texture2D<float2>  SceneVelocity;

// Sampler bilineal con clamp. Usado para muestrear SceneColor (SampleLevel en cuantizacion UV)
// y tambien para el muestreo con compensacion de jitter de SceneDepth y GBufferA.
SamplerState       LinearClampSampler;

// =============================================================================
// Recurso de salida — Unordered Access View (UAV)
// =============================================================================

RWTexture2D<float4> OutputTexture;

// =============================================================================
// Constant buffer $Globals
//
// Layout exacto (sincronizado con FEdgePreservingPixelationCS::FParameters):
//
// Registro 0 [bytes  0-15]: ViewRect
// Registro 1 [bytes 16-31]: InverseViewSize | PixelSize | Padding0
// Registro 2 [bytes 32-47]: JitterCompensation | TemporalJitterY | FrameIndex | Padding1
// Registro 3 [bytes 48-63]: EdgeThreshold | DebugMode | DepthWeight | NormalWeight
//
// Nota: cbuffer View{} (declarado en Common.ush) es un uniform buffer independiente
//       enlazado por RDG desde Parameters->View = View.ViewUniformBuffer.
//       No ocupa registros de $Globals.
// =============================================================================

float4  ViewRect;

float2  InverseViewSize;
float   PixelSize;
float   Padding0;

// Factor de activacion de la compensacion de jitter TAA (0.0 = desactivado, 1.0 = activo).
// Cuando es 1.0, los muestreos de SceneDepth y GBufferA usan UV desplazada por JitterUVDelta.
// CVar: EPP.JitterCompensation.
float   JitterCompensation;
float   TemporalJitterY;   // reservado
float   FrameIndex;        // reservado
float   Padding1;

float   EdgeThreshold;
float   DebugMode;
float   DepthWeight;
float   NormalWeight;

// =============================================================================
// Utilidades de profundidad y normal — muestreo puntual con compensacion de jitter
//
// Ambas funciones reciben JitterPx (offset en espacio de pixel, precomputado
// en MainCS) y usan Load() sobre el texel entero mas cercano al centroide
// compensado.
//
// Por que Load puntual y NO SampleLevel bilineal:
//   La profundidad es una funcion escalon en bordes geometricos: interpolar
//   bilinealmente entre el texel de primer plano y el de fondo produce un
//   valor artificial (media ponderada de dos superficies distintas) que:
//     a) Varia con la fraccion sub-pixel de la UV compensada, que cambia
//        cada frame al cambiar el jitter → introduce variacion adicional.
//     b) No tiene significado geometrico (no hay superficie a esa profundidad
//        intermedia); el operador Sobel ve un gradiente suavizado en lugar del
//        escalon real, lo que puede hacer que CombinedScore cruce EdgeThreshold
//        de forma distinta cada frame.
//   Las normales del GBuffer no son un espacio lineal: la media bilineal de
//   dos normales codificadas no produce una normal valida sin renormalizar.
//   En cambio, round() elige el texel entero que mejor representa la posicion
//   de la geometria neutral del centroide en este frame. El resultado es
//   deterministico dado un valor fijo de JitterPx.
// =============================================================================

// ----------------------------------------------------------------------------
// SampleLinearDepth
//
// Lee SceneDepth en el texel entero mas cercano a (ScreenCoord + JitterPx) y
// convierte el device-Z a profundidad lineal (cm en UE5) via ConvertFromDeviceZ().
//
// Por que ConvertFromDeviceZ():
//   UE5 usa reversed-Z y far infinito. ConvertFromDeviceZ() usa
//   View.InvDeviceZToWorldZTransform (precalculado) y es el unico metodo
//   robusto y portable para linealizar profundidad.
//
// Cuando JitterPx == (0,0) (compensacion desactivada o jitter nulo),
// round(ScreenCoord + (0,0)) == ScreenCoord → identico a un Load sin compensacion.
//
// Parametros:
//   ScreenCoord — coordenada entera base (centroide del bloque o vecino Sobel).
//   JitterPx    — offset en pixeles de compensacion TAA (float2, puede ser fraccionario).
// Devuelve: profundidad lineal positiva en unidades de mundo.
// ----------------------------------------------------------------------------
float SampleLinearDepth(int2 ScreenCoord, float2 JitterPx)
{
    // round() snappea al texel mas cercano tras el offset sub-pixel.
    // clamp al viewport: el offset puede llevar el texel 1 pixel fuera del area activa.
    int2 TexelCoord = clamp(
        int2(round(float2(ScreenCoord) + JitterPx)),
        int2(ViewRect.xy),
        int2(ViewRect.x + ViewRect.z - 1, ViewRect.y + ViewRect.w - 1)
    );
    float DeviceZ = SceneTexturesStruct.SceneDepthTexture.Load(int3(TexelCoord, 0)).r;
    return ConvertFromDeviceZ(DeviceZ);
}

// ----------------------------------------------------------------------------
// SampleGBufferNormal
//
// Lee GBufferA (normal codificada en [0,1]) en el texel entero mas cercano
// a (ScreenCoord + JitterPx). Muestreo puntual por las mismas razones que
// SampleLinearDepth.
//
// Parametros y convencion: identicos a SampleLinearDepth.
// Devuelve: normal codificada como float3 en rango [0,1] por canal.
// ----------------------------------------------------------------------------
float3 SampleGBufferNormal(int2 ScreenCoord, float2 JitterPx)
{
    int2 TexelCoord = clamp(
        int2(round(float2(ScreenCoord) + JitterPx)),
        int2(ViewRect.xy),
        int2(ViewRect.x + ViewRect.z - 1, ViewRect.y + ViewRect.w - 1)
    );
    return SceneTexturesStruct.GBufferATexture.Load(int3(TexelCoord, 0)).rgb;
}

// ----------------------------------------------------------------------------
// ComputeDepthEdgeScore
//
// Detecta discontinuidades reales de profundidad con el test min(Dev2, Jump)
// sobre los 4 ejes del kernel 3x3. Ver comentario completo en la version
// anterior del shader.
//
// Cambio en Fase 4: recibe JitterUVDelta y lo pasa a SampleLinearDepth,
// que usa round(ScreenCoord + JitterPx) + Load() para leer el texel entero
// mas cercano a la posicion neutral-geometrica del centroide compensado.
//
// Parametros:
//   PixelCoord    — centroide del bloque en el render target.
//   JitterUVDelta — offset UV de compensacion TAA.
//   OutMinDepth   — profundidad minima del vecindario 3x3 (salida).
// Devuelve: puntuacion de borde de profundidad, adimensional.
// ----------------------------------------------------------------------------
float ComputeDepthEdgeScore(int2 PixelCoord, float2 JitterUVDelta, out float OutMinDepth)
{
    int2 VPMin = int2(ViewRect.xy);
    int2 VPMax = int2(ViewRect.x + ViewRect.z - 1,
                      ViewRect.y + ViewRect.w - 1);

    float p[3][3];
    float MinDepth = 1.0e38f;
    [unroll]
    for (int dy = -1; dy <= 1; dy++)
    {
        [unroll]
        for (int dx = -1; dx <= 1; dx++)
        {
            // Clamp entero al viewport; el offset de jitter se aplica dentro
            // de SampleLinearDepth (en UV, con clamp del sampler si sobrepasa el RT).
            int2 SampleCoord = clamp(PixelCoord + int2(dx, dy), VPMin, VPMax);
            float D = SampleLinearDepth(SampleCoord, JitterUVDelta);
            p[dy + 1][dx + 1] = D;
            MinDepth = min(MinDepth, D);
        }
    }
    OutMinDepth = MinDepth;

    float C = p[1][1];

    // min(Dev2, Jump) por eje: alto solo para escalones asimetricos reales.
    float ScoreH  = min(abs(2.0f*C - p[1][0] - p[1][2]),  abs(p[1][0] - p[1][2]));
    float ScoreV  = min(abs(2.0f*C - p[0][1] - p[2][1]),  abs(p[0][1] - p[2][1]));
    float ScoreD1 = min(abs(2.0f*C - p[0][0] - p[2][2]),  abs(p[0][0] - p[2][2]));
    float ScoreD2 = min(abs(2.0f*C - p[0][2] - p[2][0]),  abs(p[0][2] - p[2][0]));

    float Score = max(max(ScoreH, ScoreV), max(ScoreD1, ScoreD2));
    return Score / max(MinDepth, 1.0f);
}

// ----------------------------------------------------------------------------
// ComputeNormalEdgeScore
//
// Detecta discontinuidades reales de la normal del GBuffer (GBufferA.rgb)
// con el test min(Dev2, Jump) vectorial sobre 4 ejes. Ver comentario completo
// en la version anterior del shader.
//
// Cambio en Fase 4: recibe JitterUVDelta y lo pasa a SampleGBufferNormal.
//
// Parametros:
//   PixelCoord    — centroide del bloque en el render target.
//   JitterUVDelta — offset UV de compensacion TAA.
// Devuelve: puntuacion de borde de normal, adimensional.
// ----------------------------------------------------------------------------
float ComputeNormalEdgeScore(int2 PixelCoord, float2 JitterUVDelta)
{
    int2 VPMin = int2(ViewRect.xy);
    int2 VPMax = int2(ViewRect.x + ViewRect.z - 1,
                      ViewRect.y + ViewRect.w - 1);

    float3 p[3][3];
    [unroll]
    for (int dy = -1; dy <= 1; dy++)
    {
        [unroll]
        for (int dx = -1; dx <= 1; dx++)
        {
            int2 SampleCoord = clamp(PixelCoord + int2(dx, dy), VPMin, VPMax);
            p[dy + 1][dx + 1] = SampleGBufferNormal(SampleCoord, JitterUVDelta);
        }
    }

    float3 C = p[1][1];
    const float3 OneThird = float3(1.0f / 3.0f, 1.0f / 3.0f, 1.0f / 3.0f);

    float ScoreH  = dot(min(abs(2.0f*C - p[1][0] - p[1][2]),  abs(p[1][0] - p[1][2])),  OneThird);
    float ScoreV  = dot(min(abs(2.0f*C - p[0][1] - p[2][1]),  abs(p[0][1] - p[2][1])),  OneThird);
    float ScoreD1 = dot(min(abs(2.0f*C - p[0][0] - p[2][2]),  abs(p[0][0] - p[2][2])),  OneThird);
    float ScoreD2 = dot(min(abs(2.0f*C - p[0][2] - p[2][0]),  abs(p[0][2] - p[2][0])),  OneThird);

    return max(max(ScoreH, ScoreV), max(ScoreD1, ScoreD2));
}

// =============================================================================
// Punto de entrada del Compute Shader
// =============================================================================

[numthreads(THREADGROUP_SIZE_X, THREADGROUP_SIZE_Y, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    uint2 PixelCoord = DispatchThreadId.xy + uint2(ViewRect.xy);

    if (PixelCoord.x >= uint(ViewRect.x + ViewRect.z) ||
        PixelCoord.y >= uint(ViewRect.y + ViewRect.w))
    {
        return;
    }

    // =========================================================================
    // PASO 1 — Cuantizacion UV (pixelacion por bloques regulares)
    // =========================================================================
    float2 LocalPixel         = float2(DispatchThreadId.xy);
    float2 BlockIndex         = floor(LocalPixel / PixelSize);
    float2 BlockCentroidLocal = (BlockIndex + 0.5f) * PixelSize;
    float2 CentroidScreen     = BlockCentroidLocal + float2(ViewRect.xy);
    float2 QuantizedUV        = (CentroidScreen + 0.5f) * InverseViewSize;

    float4 CentroidColor = SceneColor.SampleLevel(LinearClampSampler, QuantizedUV, 0.0f);

    // =========================================================================
    // PASO 2 — Compensacion de jitter TAA para el detector de bordes
    //
    // View.TemporalAAJitter.xy es el offset que el motor aplica al frustum de
    // proyeccion en espacio NDC [-1,1]:
    //   jittered_NDC = neutral_NDC + TemporalAAJitter.xy
    //
    // Consecuencia: la geometria en posicion neutral P aparece en la pantalla
    // desplazada por jitter_px pixeles. Al leer SceneDepth con Load() en el
    // centroide entero BlockCentroidCoord, cada frame se lee la geometria en
    // una posicion neutral diferente (BlockCentroidCoord - jitter_px), lo que
    // hace que el Sobel produzca puntuaciones distintas frame a frame cerca de
    // bordes geometricos → parpadeo binario borde/no-borde.
    //
    // Solucion: calcular JitterUVDelta a partir de View.TemporalAAJitter.xy y pasarlo
    // a SampleLinearDepth / SampleGBufferNormal, donde round(ScreenCoord + JitterPx)
    // elige el texel entero mas cercano a la posicion neutral-geometrica del centroide.
    // Esto estabiliza la lectura: el texel elegido solo cambia si el jitter supera medio
    // pixel, lo que ocurre raramente. No se usa SampleLevel (bilineal) porque interpolar
    // profundidad en bordes escalon produce valores geometricamente invalidos.
    //
    // Derivacion de JitterUVDelta (en UV sobre el render target completo):
    //   jitter_px.x =  TemporalAAJitter.x * ViewRect.z / 2   (NDC → pixeles, eje X)
    //   jitter_px.y = -TemporalAAJitter.y * ViewRect.w / 2   (NDC → pixeles, eje Y
    //                                                          con signo invertido:
    //                                                          NDC.y positivo = arriba =
    //                                                          pixel Y menor)
    //   JitterUVDelta.x =  jitter_px.x * InverseViewSize.x
    //                   =  TemporalAAJitter.x * ViewRect.z * InverseViewSize.x * 0.5
    //   JitterUVDelta.y =  TemporalAAJitter.y * (-ViewRect.w * InverseViewSize.y * 0.5)
    //
    // Caso viewport == RT (tipico): ViewRect.z * InverseViewSize.x = 1, por lo que
    //   JitterUVDelta ≈ TemporalAAJitter.xy * float2(0.5, -0.5)
    // (coincide con la formula NDC→UV estandar de UE5).
    //
    // Cuando JitterCompensation == 0: JitterUVDelta = (0,0) → round(ScreenCoord + 0)
    // == ScreenCoord → Load identico al de Fases anteriores. Sin cambio de comportamiento.
    // Util para ablacion A/B con EPP.JitterCompensation.
    // =========================================================================
    float2 JitterUVDelta = View.TemporalAAJitter.xy
                           * float2( ViewRect.z * InverseViewSize.x,
                                    -ViewRect.w * InverseViewSize.y)
                           * (0.5f * JitterCompensation);

    // =========================================================================
    // PASO 2 (cont.) — Deteccion de bordes geometricos a nivel de BLOQUE
    //
    // INVARIANTE DE REJILLA: toda la evaluacion de borde se realiza UNA SOLA VEZ
    // por bloque, en el texel del CENTROIDE. Ver comentario en versiones anteriores.
    // =========================================================================
    int2 BlockCentroidCoord = int2(CentroidScreen);

    float MinNeighborDepth;
    float RelativeDepthDev = ComputeDepthEdgeScore(BlockCentroidCoord, JitterUVDelta, MinNeighborDepth);
    float NormalGrad       = ComputeNormalEdgeScore(BlockCentroidCoord, JitterUVDelta);

    float CombinedScore = DepthWeight * RelativeDepthDev + NormalWeight * NormalGrad;
    bool bIsEdge = (CombinedScore > EdgeThreshold);

    // =========================================================================
    // MODO DEBUG — Visualizacion de bordes detectados (blanco sobre negro)
    // =========================================================================
    if (DebugMode >= 0.5f)
    {
        float EdgeMask = bIsEdge ? 1.0f : 0.0f;
        OutputTexture[PixelCoord] = float4(EdgeMask, EdgeMask, EdgeMask, 1.0f);
        return;
    }

    // =========================================================================
    // PASO 3b — Mezcla adaptativa consciente de profundidad
    //
    // El barrido de profundidad del bloque (para encontrar el texel mas cercano)
    // usa SampleLinearDepth con JitterUVDelta = (0,0): buscamos el texel de menor
    // profundidad en la rejilla de pantalla real, no en la posicion compensada.
    // Esto es correcto porque el barrido determina que TEXEL de SceneColor
    // muestrear (una decision de UI/estetica), no una medida geometrica.
    // Solo el detector Sobel necesita compensacion (medida estable de discontinuidades).
    // =========================================================================
    float BlendFactor = saturate(CombinedScore / max(EdgeThreshold, 1e-4f));
    float4 FinalColor = CentroidColor;

    [branch]
    if (BlendFactor > 0.01f)
    {
        int  iPixelSize    = max(1, int(PixelSize));
        int2 iBlockOrigin  = int2(BlockIndex) * iPixelSize;
        int2 VPMin         = int2(ViewRect.xy);
        int2 VPMax         = int2(ViewRect.x + ViewRect.z - 1,
                                  ViewRect.y + ViewRect.w - 1);

        float MinD         = 1.0e38f;
        int2  NearestLocal = iBlockOrigin;

        [loop]
        for (int by = 0; by < iPixelSize; by++)
        {
            [loop]
            for (int bx = 0; bx < iPixelSize; bx++)
            {
                int2 LocalCoord  = iBlockOrigin + int2(bx, by);
                int2 ScreenCoord = clamp(LocalCoord + int2(ViewRect.xy), VPMin, VPMax);
                // Barrido de profundidad sin compensacion de jitter: queremos el texel
                // mas proximo en la rejilla de pantalla actual, no el neutral-geometrico.
                float D = SampleLinearDepth(ScreenCoord, float2(0.0f, 0.0f));
                if (D < MinD)
                {
                    MinD         = D;
                    NearestLocal = LocalCoord;
                }
            }
        }

        float2 NearestUV    = (float2(NearestLocal + int2(ViewRect.xy)) + 0.5f)
                              * InverseViewSize;
        float4 NearestColor = SceneColor.SampleLevel(LinearClampSampler, NearestUV, 0.0f);

        FinalColor = lerp(CentroidColor, NearestColor, BlendFactor);
    }

    OutputTexture[PixelCoord] = FinalColor;
}
