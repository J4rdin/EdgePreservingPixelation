// EdgePreservingPixelation.usf
// TFG: Pipeline de pixelacion en tiempo real con preservacion de bordes.
// Fase 3: Deteccion de bordes geometricos via puntuacion combinada de dos senales,
//         cada una evaluada con el test min(Dev2, Jump) por eje:
//
//   Test min(Dev2, Jump) para un par de vecinos opuestos (A, Centro, B):
//     Dev2 = |2*C - A - B|  (diferencia de segundo orden: cero en rampas lineales)
//     Jump = |A - B|        (diferencia de primer orden: cero en curvatura simetrica)
//     Score = min(Dev2, Jump)
//
//     Caso ramp/pendiente plana: A = C-k, B = C+k → Dev2=0, min=0.
//     Caso curvatura simetrica: A = C-k, B = C-k → Jump=0, min=0.
//     Caso escalon real: un lado muy distinto del otro → ambos grandes, min grande.
//
//   Senal 1 — Profundidad lineal (SceneDepth): 4 ejes H/V/D1/D2, max de los scores.
//     Normalizado por la profundidad minima del vecindario (invariante a distancia,
//     sin dilucion por el fondo lejano).
//
//   Senal 2 — Normal del GBuffer (GBufferA.rgb): misma logica vectorial, media de canales.
//
//   Fusion: CombinedScore = DepthWeight * Score1 + NormalWeight * Score2 > EdgeThreshold.
//
//         Modo debug (EPP.DebugMode 1): bordes en blanco sobre negro para verificacion aislada.
//         La mezcla adaptativa borde/centroide se implementara en Fase 4.
//
// Compatible con UE5 5.5, Shader Model 5+ (D3D12 / Vulkan).
// Punto de entrada del Compute Shader: MainCS.

// Platform.ush:         macros y tipos de compatibilidad entre backends (D3D12, Vulkan, Metal).
// Common.ush:           declara cbuffer View{} (InvDeviceZToWorldZTransform, etc.) y ConvertFromDeviceZ().
// SceneTexturesCommon.ush: declara el uniform buffer SceneTexturesStruct (FSceneTextureUniformParameters)
//                       y los helpers CalcSceneDepth(uint2), CalcSceneDepth(float2), etc.
//                       Incluye Common.ush internamente; todos usan #pragma once, sin duplicaciones.
#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"
#include "/Engine/Private/SceneTexturesCommon.ush"

// =============================================================================
// Recursos de entrada — Shader Resource Views (SRV)
// Vinculados por nombre desde FEdgePreservingPixelationCS::FParameters via RDG.
// =============================================================================

// Color de escena LDR post-tonemap. Formato tipico: B8G8R8A8 o R10G10B10A2.
Texture2D          SceneColor;

// Buffer de velocidad por pixel en NDC/frame. Reservado para Fase 4 (estabilizacion temporal).
Texture2D<float2>  SceneVelocity;

// SceneDepth se accede a traves del uniform buffer SceneTexturesStruct (declarado por
// SceneTexturesCommon.ush, enlazado desde SHADER_PARAMETER_RDG_UNIFORM_BUFFER).
// Uso: SceneTexturesStruct.SceneDepthTexture.Load(int3(coord, 0)).r

// Sampler bilineal con clamp. Usado exclusivamente para muestrear SceneColor.
// SceneDepth se accede con Load() (muestra puntual exacta, sin interpolacion).
SamplerState       LinearClampSampler;

// =============================================================================
// Recurso de salida — Unordered Access View (UAV)
// =============================================================================

// Textura de salida con acceso de escritura aleatoria.
RWTexture2D<float4> OutputTexture;

// =============================================================================
// Constant buffer $Globals — generado por UE5 a partir de los campos
// SHADER_PARAMETER() de FEdgePreservingPixelationCS::FParameters.
//
// El layout HLSL de variables globales debe coincidir byte a byte con el orden
// de declaracion en FParameters (el engine no reordena; el programador garantiza
// la alineacion con padding explicito).
//
// Registro 0 [bytes  0-15]: ViewRect
// Registro 1 [bytes 16-31]: InverseViewSize | PixelSize | Padding0
// Registro 2 [bytes 32-47]: TemporalJitterX | TemporalJitterY | FrameIndex | Padding1
// Registro 3 [bytes 48-63]: EdgeThreshold | DebugMode | DepthWeight | NormalWeight
//
// Nota: cbuffer View{} (declarado en Common.ush) es un uniform buffer independiente
//       enlazado por RDG desde Parameters->View = View.ViewUniformBuffer.
//       No ocupa ninguno de los registros de $Globals listados arriba.
// =============================================================================

// Region activa del viewport en pixeles del render target: [OffsetX, OffsetY, Width, Height].
float4  ViewRect;

// Inversa del tamano del render target: (1/RTWidth, 1/RTHeight).
// Convierte coordenadas de pixel a UV normalizadas [0,1] sobre el render target completo.
float2  InverseViewSize;
// Tamano del bloque de pixelacion en pixeles (ej: 8.0 → bloques 8×8).
float   PixelSize;
// Relleno explicito: completa el Registro 1 a 16 bytes. Sin semantica.
float   Padding0;

// Reservados para Fase 4 (estabilizacion temporal con SceneVelocity).
float   TemporalJitterX;
float   TemporalJitterY;
float   FrameIndex;
// Relleno explicito: completa el Registro 2 a 16 bytes. Sin semantica.
float   Padding1;

// Umbral aplicado sobre la puntuacion combinada de borde:
//   CombinedScore = DepthWeight * GradDepthRelativo + NormalWeight * GradNormal
// Rango util: [0.02, 0.5]. CVar: EPP.EdgeThreshold.
float   EdgeThreshold;
// Selector de modo de salida:
//   0.0 → pixelacion normal.
//   1.0 → debug: bordes en blanco sobre negro.
// CVar: EPP.DebugMode.
float   DebugMode;
// Peso del gradiente Sobel de profundidad relativa en la puntuacion combinada.
// Escala la desviacion de planaridad relativa (segundo orden, adimensional).
// CVar: EPP.DepthWeight. Defecto: 1.0.
float   DepthWeight;
// Peso del gradiente Sobel de normal del GBuffer en la puntuacion combinada.
// Escala el gradiente en espacio de normal codificada (rango [0,1] por canal).
// CVar: EPP.NormalWeight. Defecto: 1.0.
float   NormalWeight;

// =============================================================================
// Utilidades de profundidad
// =============================================================================

// ----------------------------------------------------------------------------
// SampleLinearDepth
//
// Lee el device Z del texel indicado y lo convierte a profundidad lineal en
// unidades de mundo (centimetros en UE5) usando ConvertFromDeviceZ() de Common.ush.
//
// Por que la formula generica es incorrecta en UE5:
//
//   Formula directa (direct-Z, OpenGL):  linearZ = near * far / (far - DeviceZ*(far - near))
//   Esta formula FALLA en UE5 por dos razones independientes:
//
//   1) Reversed-Z: UE5 invierte el rango de profundidad respecto al estandar OpenGL.
//      near → DeviceZ=1, far → DeviceZ=0. La formula directa calcula el reciproco
//      incorrecto con esta convencion.
//
//   2) Far infinito: la proyeccion perspectiva de UE5 5.x usa far → ∞. Sustituir ∞
//      en la formula produce una expresion indeterminada; ademas 'far' no es accesible
//      como un float finito util desde el shader.
//
//   ConvertFromDeviceZ() usa View.InvDeviceZToWorldZTransform (float4), precalculado
//   por el engine a partir de la matriz de proyeccion actual. Codifica correctamente
//   reversed-Z, far infinito, perspectiva y ortografica sin exponer near/far al shader.
//   Es la unica forma robusta y portable de linealizar profundidad en UE5.
//
// Parametro: ScreenCoord — coordenada entera en espacio del render target [px].
// Devuelve:  profundidad lineal positiva en unidades de mundo (crece con la distancia).
// ----------------------------------------------------------------------------
float SampleLinearDepth(int2 ScreenCoord)
{
    // SceneTexturesStruct.SceneDepthTexture es el depth-stencil buffer real de escena,
    // enlazado por el UB FSceneTextureUniformParameters (creado con ESceneTextureSetupMode::SceneDepth).
    // Load() accede exactamente al texel indicado, sin interpolacion bilineal.
    // Interpolar profundidad en bordes geometricos generaria valores promediados
    // sin correspondencia geometrica, contaminando la deteccion de discontinuidades.
    float DeviceZ = SceneTexturesStruct.SceneDepthTexture.Load(int3(ScreenCoord, 0)).r;
    return ConvertFromDeviceZ(DeviceZ);
}

// ----------------------------------------------------------------------------
// ComputeDepthEdgeScore
//
// Detecta discontinuidades reales de profundidad distinguiendolas de pendientes
// suaves y de la curvatura interior de objetos.
//
// Test min(Dev2, Jump) por eje — por que funciona:
//
//   Para un par de vecinos opuestos (A, Centro=C, B):
//     Dev2  = |2C - A - B|    diferencia de segundo orden
//     Jump  = |A - B|         diferencia de primer orden (magnitud del salto)
//     Score = min(Dev2, Jump)
//
//   Caso ramp/pendiente plana (suelo oblicuo): A=C-k, B=C+k (progresion lineal)
//     Dev2 = 0  (la rampa es predecible por interpolacion lineal)
//     min(0, 2k) = 0.  ← Suprime el falso positivo del suelo. ✓
//
//   Caso curvatura simetrica (interior de esfera o cilindro):
//     A = C-k, B = C-k (ambos vecinos a igual distancia del centro, simetria par)
//     Jump = |A-B| = 0  (vecinos simetricos, sin salto entre ellos)
//     min(2k, 0) = 0.  ← Suprime el interior de objetos curvos. ✓
//
//   Caso escalon geometrico real (oclusion, silueta):
//     Un vecino es la superficie proxima, el otro el fondo lejano.
//     El par es fuertemente asimetrico: Dev2 grande Y Jump grande.
//     min(grande, grande) = grande.  ← Detecta el borde. ✓
//
// Se evaluan 4 ejes (H, V, diagonal NW-SE, diagonal NE-SW); se toma el maximo
// para responder al eje con el escalon mas pronunciado sin acumular ruido.
//
// Normalizacion por la profundidad minima del vecindario 3×3 (no la del pixel
// central): la metrica es invariante a distancia de camara y no se diluye cuando
// el pixel central cae en el lado lejano del borde.
//
// Parametros:
//   PixelCoord — coordenada entera absoluta en el render target [px].
//   OutMinDepth — profundidad lineal minima del vecindario 3×3 [cm].
// Devuelve: puntuacion de borde de profundidad, adimensional.
// ----------------------------------------------------------------------------
float ComputeDepthEdgeScore(int2 PixelCoord, out float OutMinDepth)
{
    // Limites inclusivos del viewport en coordenadas enteras de render target.
    int2 VPMin = int2(ViewRect.xy);
    int2 VPMax = int2(ViewRect.x + ViewRect.z - 1,
                      ViewRect.y + ViewRect.w - 1);

    // Muestreo de la cuadricula 3×3 centrada en PixelCoord.
    // p[row][col], con row/col ∈ {0,1,2} correspondiente a offset (dy,dx) ∈ {-1,0,+1}.
    float p[3][3];
    float MinDepth = 1.0e38f;
    [unroll]
    for (int dy = -1; dy <= 1; dy++)
    {
        [unroll]
        for (int dx = -1; dx <= 1; dx++)
        {
            int2 SampleCoord = clamp(PixelCoord + int2(dx, dy), VPMin, VPMax);
            float D = SampleLinearDepth(SampleCoord);
            p[dy + 1][dx + 1] = D;
            MinDepth = min(MinDepth, D);
        }
    }
    OutMinDepth = MinDepth;

    float C = p[1][1];

    // min(Dev2, Jump) por eje:
    //   Dev2  = |2C - A - B|   suprime rampas lineales (Dev2 = 0 para rampas)
    //   Jump  = |A - B|        suprime curvatura simetrica (Jump = 0 si A == B)
    //   Score = min: alto solo si el par es asimetrico en AMBAS medidas → escalon real
    float ScoreH  = min(abs(2.0f*C - p[1][0] - p[1][2]),  abs(p[1][0] - p[1][2]));
    float ScoreV  = min(abs(2.0f*C - p[0][1] - p[2][1]),  abs(p[0][1] - p[2][1]));
    float ScoreD1 = min(abs(2.0f*C - p[0][0] - p[2][2]),  abs(p[0][0] - p[2][2]));
    float ScoreD2 = min(abs(2.0f*C - p[0][2] - p[2][0]),  abs(p[0][2] - p[2][0]));

    float Score = max(max(ScoreH, ScoreV), max(ScoreD1, ScoreD2));

    // Normalizacion por profundidad minima del vecindario.
    // max(..., 1.0) previene division por zero si toda la escena esta a < 1 cm.
    return Score / max(MinDepth, 1.0f);
}

// ----------------------------------------------------------------------------
// SampleGBufferNormal
//
// Lee el texel de GBufferA en la coordenada indicada y devuelve los tres canales
// RGB como un float3. GBufferA almacena la normal de superficie codificada en
// espacio de mundo, empaquetada como (N * 0.5 + 0.5) → rango [0,1] por canal.
//
// No se decodifica a normal unitaria [-1,1]: para deteccion de discontinuidades
// basta con detectar cambios en el valor codificado; una normal constante produce
// gradiente ~0 independientemente de la codificacion, y un cambio de orientacion
// produce gradiente no nulo en los mismos texeles en ambas representaciones.
//
// Load() accede al texel exacto sin interpolacion bilineal, igual que en SampleLinearDepth.
//
// Parametro: ScreenCoord — coordenada entera en espacio del render target [px].
// Devuelve:  normal codificada como float3 en rango [0,1] por canal.
// ----------------------------------------------------------------------------
float3 SampleGBufferNormal(int2 ScreenCoord)
{
    return SceneTexturesStruct.GBufferATexture.Load(int3(ScreenCoord, 0)).rgb;
}

// ----------------------------------------------------------------------------
// ComputeNormalEdgeScore
//
// Detecta discontinuidades reales de la normal del GBuffer (GBufferA.rgb)
// distinguiendolas de la curvatura suave de superficies curvas.
//
// Aplica el mismo test min(Dev2, Jump) que ComputeDepthEdgeScore, pero
// operando sobre vectores float3 (un valor por canal RGB de la normal codificada):
//
//   Para un par opuesto (A, C, B), por canal:
//     Dev2  = |2C - A - B|   (3-vector)   cero en variacion lineal de la normal
//     Jump  = |A - B|         (3-vector)   cero si ambos vecinos tienen la misma normal
//     Score_canal = min(Dev2_canal, Jump_canal)
//
//   La normal de una superficie CURVA varia aproximadamente como una funcion
//   circular, cuya segunda diferencia discreta es O(curvatura²·h²) mientras
//   que la primera diferencia es O(curvatura·h). El min de ambas es O(curvatura²·h²),
//   de magnitud muy inferior a la de una arista real (O(1)).
//   Esto suprime la curvatura suave de esferas, cilindros y meshes redondeados.
//
//   Una ARISTA REAL (cruce entre dos normales muy diferentes) produce un par
//   fuertemente asimetrico: Dev2 grande Y Jump grande → min grande. ✓
//
//   Una superficie PLANA tiene normal constante → todos los terminos son 0. ✓
//
// Se evaluan 4 ejes (H, V, D1, D2). Para cada eje, el score escalar es la
// media de los scores por canal: dot(min(Dev2, Jump), (1/3, 1/3, 1/3)).
// El resultado final es el maximo de los cuatro ejes.
//
// Parametro: PixelCoord — coordenada entera absoluta en el render target [px].
// Devuelve:  puntuacion de borde de normal, adimensional.
// ----------------------------------------------------------------------------
float ComputeNormalEdgeScore(int2 PixelCoord)
{
    // Limites del viewport, igual que en ComputeDepthEdgeScore.
    int2 VPMin = int2(ViewRect.xy);
    int2 VPMax = int2(ViewRect.x + ViewRect.z - 1,
                      ViewRect.y + ViewRect.w - 1);

    // Muestreo de la cuadricula 3×3 por canal RGB.
    float3 p[3][3];
    [unroll]
    for (int dy = -1; dy <= 1; dy++)
    {
        [unroll]
        for (int dx = -1; dx <= 1; dx++)
        {
            int2 SampleCoord = clamp(PixelCoord + int2(dx, dy), VPMin, VPMax);
            p[dy + 1][dx + 1] = SampleGBufferNormal(SampleCoord);
        }
    }

    float3 C = p[1][1];
    // Factor de reduccion de 3 canales a escalar: media aritmetica de canales.
    const float3 OneThird = float3(1.0f / 3.0f, 1.0f / 3.0f, 1.0f / 3.0f);

    // min(Dev2, Jump) vectorial por eje → media de canales para obtener escalar.
    // abs() y min() operan componente a componente sobre float3 en HLSL.
    float ScoreH  = dot(min(abs(2.0f*C - p[1][0] - p[1][2]),  abs(p[1][0] - p[1][2])),  OneThird);
    float ScoreV  = dot(min(abs(2.0f*C - p[0][1] - p[2][1]),  abs(p[0][1] - p[2][1])),  OneThird);
    float ScoreD1 = dot(min(abs(2.0f*C - p[0][0] - p[2][2]),  abs(p[0][0] - p[2][2])),  OneThird);
    float ScoreD2 = dot(min(abs(2.0f*C - p[0][2] - p[2][0]),  abs(p[0][2] - p[2][0])),  OneThird);

    return max(max(ScoreH, ScoreV), max(ScoreD1, ScoreD2));
}

// =============================================================================
// Punto de entrada del Compute Shader
// Grupo de hilos: 8×8 = 64 hilos (optimo para warp/wavefront de 32-64 hilos).
// Los defines THREADGROUP_SIZE_X/Y se inyectan desde ModifyCompilationEnvironment.
// =============================================================================

[numthreads(THREADGROUP_SIZE_X, THREADGROUP_SIZE_Y, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    // Coordenada absoluta en el render target: id local del hilo + offset del viewport.
    uint2 PixelCoord = DispatchThreadId.xy + uint2(ViewRect.xy);

    // Descarte temprano de hilos fuera del viewport activo.
    // El numero de grupos de despacho se redondea hacia arriba al multiplo de
    // THREADGROUP_SIZE; los hilos excedentes deben descartarse explicitamente.
    if (PixelCoord.x >= uint(ViewRect.x + ViewRect.z) ||
        PixelCoord.y >= uint(ViewRect.y + ViewRect.w))
    {
        return;
    }

    // =========================================================================
    // PASO 1 — Cuantizacion UV (pixelacion por bloques regulares)
    //
    // Todos los pixeles que pertenecen al mismo bloque de PixelSize×PixelSize
    // muestrean SceneColor en el centroide geometrico de ese bloque, produciendo
    // regiones de color uniforme (estetica de pixelacion retro).
    //
    // Calculo en espacio LOCAL al viewport (coordenadas [0, ViewportDim-1]):
    //   BlockIndex         = floor(LocalPixel / PixelSize)
    //   BlockCentroidLocal = (BlockIndex + 0.5) * PixelSize   (+0.5: centro geometrico)
    //   CentroidScreen     = BlockCentroidLocal + ViewRect.xy  (espacio render target)
    //   QuantizedUV        = (CentroidScreen + 0.5) * InverseViewSize  (UV normalizada)
    // =========================================================================
    float2 LocalPixel         = float2(DispatchThreadId.xy);
    float2 BlockIndex         = floor(LocalPixel / PixelSize);
    float2 BlockCentroidLocal = (BlockIndex + 0.5f) * PixelSize;
    float2 CentroidScreen     = BlockCentroidLocal + float2(ViewRect.xy);
    float2 QuantizedUV        = (CentroidScreen + 0.5f) * InverseViewSize;

    // SampleLevel con LOD 0 explicito: ddx/ddy no estan disponibles en compute shaders.
    float4 PixelatedColor = SceneColor.SampleLevel(LinearClampSampler, QuantizedUV, 0.0f);

    // =========================================================================
    // PASO 2 — Deteccion de bordes geometricos via puntuacion combinada
    //
    // Cada pixel se clasifica independientemente del bloque de pixelacion al que
    // pertenezca. La clasificacion se usara en Fase 4 para la mezcla adaptativa.
    //
    // Senal 1 — Desviacion de planaridad de profundidad (segundo orden):
    //   Evalua si la profundidad del pixel central es predecible interpolando vecinos
    //   opuestos. Una pendiente plana → desviacion ~0. Un escalon real → desviacion alta.
    //   Normalizada por la profundidad minima del vecindario 3×3 (no la del centro):
    //   invariante a distancia de camara, sin dilucion por el fondo lejano en bordes
    //   donde el pixel central cae en la superficie distante.
    //
    // Senal 2 — Sobel de primer orden sobre normal del GBuffer (GBufferA.rgb):
    //   Una superficie plana oblicua tiene normal constante → gradiente ~0. Una arista
    //   real entre dos superficies de distinta orientacion → gradiente elevado.
    //
    // Fusion: CombinedScore = DepthWeight * DesvPlanaridad + NormalWeight * GradNormal
    //   Un borde fuerte en cualquiera de las dos senales supera EdgeThreshold.
    //   Un suelo oblicuo: DesvPlanaridad≈0 (plano lineal) y GradNormal≈0 (normal constante)
    //   → CombinedScore pequeno → no se detecta como borde.
    // =========================================================================

    // --- Senal 1: puntuacion de borde de profundidad ---
    // min(Dev2, Jump) por eje sobre profundidad lineal, normalizado por MinDepth.
    // Suprime rampas (Dev2=0) y curvatura simetrica (Jump=0). Solo escalones reales
    // producen un score alto. El valor devuelto ya es adimensional.
    float MinNeighborDepth;
    float RelativeDepthDev = ComputeDepthEdgeScore(int2(PixelCoord), MinNeighborDepth);

    // --- Senal 2: puntuacion de borde de normal ---
    // min(Dev2, Jump) vectorial sobre GBufferA.rgb. Suprime curvatura suave de esferas
    // y objetos redondeados; detecta aristas reales y transiciones bruscas de normal.
    float NormalGrad = ComputeNormalEdgeScore(int2(PixelCoord));

    // --- Puntuacion combinada y clasificacion binaria ---
    // La suma ponderada integra ambas senales sin exigir que las dos sean fuertes.
    float CombinedScore = DepthWeight * RelativeDepthDev + NormalWeight * NormalGrad;
    bool bIsEdge = (CombinedScore > EdgeThreshold);

    // =========================================================================
    // MODO DEBUG — Visualizacion de bordes detectados (blanco sobre negro)
    //
    // Muestra la clasificacion binaria bIsEdge: blanco = borde, negro = interior.
    // Permite ajustar EPP.EdgeThreshold, EPP.DepthWeight y EPP.NormalWeight en
    // tiempo real e inspeccionar el resultado antes de integrar la mezcla adaptativa
    // de Fase 4. Ignora completamente la pixelacion.
    // Activo via consola: EPP.DebugMode 1
    // =========================================================================
    if (DebugMode >= 0.5f)
    {
        float EdgeMask = bIsEdge ? 1.0f : 0.0f;
        OutputTexture[PixelCoord] = float4(EdgeMask, EdgeMask, EdgeMask, 1.0f);
        return;
    }

    // =========================================================================
    // SALIDA NORMAL — Pixelacion (sin mezcla de bordes hasta Fase 4)
    //
    // bIsEdge esta disponible para la mezcla adaptativa de Fase 4:
    //   bIsEdge=true  → mostrar color real del pixel (preservar el borde).
    //   bIsEdge=false → mostrar color del centroide del bloque (pixelacion normal).
    // =========================================================================
    OutputTexture[PixelCoord] = PixelatedColor;
}
