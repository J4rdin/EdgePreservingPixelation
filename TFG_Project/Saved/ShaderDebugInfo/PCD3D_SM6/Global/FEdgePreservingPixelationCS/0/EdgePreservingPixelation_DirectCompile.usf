float SampleLinearDepth(int2 ScreenCoord)
{



    float DeviceZ = SceneDepth.Load(int3(ScreenCoord, 0));
    return ConvertFromDeviceZ(DeviceZ);
}

#line 156 "/Plugin/EdgePreservingPixelation/Private/EdgePreservingPixelation.usf"
float ComputeSobelDepthGradient(int2 PixelCoord)
{

    int2 VPMin = int2(ViewRect.xy);
    int2 VPMax = int2(ViewRect.x + ViewRect.z - 1,
                      ViewRect.y + ViewRect.w - 1);



    float p[3][3];
    [unroll]
    for (int dy = -1; dy <= 1; dy++)
    {
        [unroll]
        for (int dx = -1; dx <= 1; dx++)
        {
            int2 SampleCoord = clamp(PixelCoord + int2(dx, dy), VPMin, VPMax);
            p[dy + 1][dx + 1] = SampleLinearDepth(SampleCoord);
        }
    }


    float Gx = (-1.0f * p[0][0] + 1.0f * p[0][2])
             + (-2.0f * p[1][0] + 2.0f * p[1][2])
             + (-1.0f * p[2][0] + 1.0f * p[2][2]);

    float Gy = (-1.0f * p[0][0] - 2.0f * p[0][1] - 1.0f * p[0][2])
             + ( 1.0f * p[2][0] + 2.0f * p[2][1] + 1.0f * p[2][2]);


    return abs(Gx) + abs(Gy);
}

#line 195 "/Plugin/EdgePreservingPixelation/Private/EdgePreservingPixelation.usf"
[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{

    uint2 PixelCoord = DispatchThreadId.xy + uint2(ViewRect.xy);




    if (PixelCoord.x >= uint(ViewRect.x + ViewRect.z) ||
        PixelCoord.y >= uint(ViewRect.y + ViewRect.w))
    {
        return;
    }














    float2 LocalPixel         = float2(DispatchThreadId.xy);
    float2 BlockIndex         = floor(LocalPixel / PixelSize);
    float2 BlockCentroidLocal = (BlockIndex + 0.5f) * PixelSize;
    float2 CentroidScreen     = BlockCentroidLocal + float2(ViewRect.xy);
    float2 QuantizedUV        = (CentroidScreen + 0.5f) * InverseViewSize;


    float4 PixelatedColor = SceneColor.SampleLevel(LinearClampSampler, QuantizedUV, 0.0f);











    float LinearDepthCenter = SampleLinearDepth(int2(PixelCoord));


    float SobelGradient = ComputeSobelDepthGradient(int2(PixelCoord));






    float RelativeGradient = SobelGradient / max(LinearDepthCenter, 1.0f);

    bool bIsEdge = (RelativeGradient > EdgeThreshold);








    if (DebugMode >= 0.5f)
    {
        float EdgeMask = bIsEdge ? 1.0f : 0.0f;
        OutputTexture[PixelCoord] = float4(EdgeMask, EdgeMask, EdgeMask, 1.0f);
        return;
    }








    OutputTexture[PixelCoord] = PixelatedColor;
}

